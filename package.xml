<?xml version="1.0"?>
<package format="3">
  <name>ultrasound_usb</name>
  <version>0.1.0</version>
  <description>Publish ultrasound images from a USB V4L2 video device.</description>
  <maintainer email="hydran00@users.noreply.github.com">hydran00</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <exec_depend>ffmpeg_image_transport</exec_depend>
  <depend>libopencv-dev</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
